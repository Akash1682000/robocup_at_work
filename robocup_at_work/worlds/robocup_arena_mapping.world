          <material><ambient>0.7 0.55 0.3 1</ambient><diffuse>0.7 0.55 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== INNER WALLS - CENTRAL ISLAND LOOP =====
         Island wall at y=0 with a loop around it, plus two chicane stubs.
         All gaps are >= 1.26 m (robot + inflation). -->

    <model name="iwall_island">
      <static>true</static>
      <pose>0 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.4 0.10 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.4 0.10 0.3</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="iwall_stub_n">
      <static>true</static>
      <pose>-1.0 2.225 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.10 1.25 0.3</size></box></geometry></collision>
