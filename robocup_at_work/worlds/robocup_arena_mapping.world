        </visual>
      </link>
    </model>

    <!-- WS02 - against WEST wall, center zone (center zone, accessible via west gap of wall B) -->
    <!-- Approach from east: x > -3.05 -->
    <model name="table_ws02">
      <static>true</static>
      <pose>-3.3 0.0 0.05 0 0 0</pose>
      <link name="link">
