        </visual>
      </link>
    </model>

    <!-- WS03 - against NORTH wall, right zone (north zone, east side, easiest access) -->
    <!-- Approach from south: direct access via east gap of wall A -->
    <model name="table_ws03">
      <static>true</static>
      <pose>2.0 2.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.5 0.1</size></box></geometry></collision>
