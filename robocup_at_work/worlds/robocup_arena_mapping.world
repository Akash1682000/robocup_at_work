        </visual>
      </link>
    </model>

    <!-- ===== WORKSTATION TABLES =====
         Against the outer walls, 0.1 m high. -->

    <!-- WS01 - against NORTH wall, left zone (north zone, west side) -->
    <!-- Approach from south: y < 2.25 (1.5m clearance from Wall A north face at y=0.75) -->
    <model name="table_ws01">
      <static>true</static>
      <pose>-2.0 2.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.5 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.5 0.1</size></box></geometry>
