        </visual>
      </link>
    </model>

    <!-- Red tape marking east entry gap (visual only) -->
    <model name="red_tape_east">
      <static>true</static>
      <pose>3.8 -0.4 0.003 0 0 1.57</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.8 0.08 0.003</size></box></geometry>
