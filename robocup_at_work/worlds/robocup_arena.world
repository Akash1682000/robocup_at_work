          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- WS04 - against EAST wall, south zone -->
    <model name="table_ws04">
      <static>true</static>
      <pose>3.3 -1.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.8 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.8 0.1</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== SLAM FEATURE PILLARS ===== -->
    <model name="pillar1">
      <static>true</static>
      <pose>-1.5 -1.5 0.5 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.1 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 0.1 1.0</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
