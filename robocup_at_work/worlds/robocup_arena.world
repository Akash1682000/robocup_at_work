    </model>

    <!-- ===== APRILTAGS (tag36h11) ON TABLE FRONT FACES ===== -->
    <!-- 0.10 m tag plates on the table fronts (tag size 0.080 m).
         Visual only, no collision. -->
    <!-- south face of table_ws01 (y=2.25), robot approaches from -y -->
    <model name="apriltag_ws01">
      <static>true</static>
      <pose>-2.000 2.248 0.05 0 0 0</pose>
      <link name="link">
        <visual name="tag">
          <geometry><box><size>0.10 0.001 0.10</size></box></geometry>
          <material>
            <script>
              <uri>model://robocup_tags/materials/scripts</uri>
              <uri>model://robocup_tags/materials/textures</uri>
              <name>RoboCupTags/Tag1</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    <!-- east face of table_ws02 (x=-3.05), robot approaches from +x -->
    <model name="apriltag_ws02">
      <static>true</static>
      <pose>-3.048 0.000 0.05 0 0 1.5708</pose>
      <link name="link">
        <visual name="tag">
          <geometry><box><size>0.10 0.001 0.10</size></box></geometry>
