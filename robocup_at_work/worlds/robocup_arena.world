<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="robocup_arena">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- /gazebo/get_entity_state and set_entity_state for the scripts,
         much faster than the gz CLI. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>0.0</update_rate>
    </plugin>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ===== FLOOR (8m x 6m) ===== -->
    <model name="arena_floor">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>8 6 0.002</size></box></geometry>
          <material><ambient>0.75 0.73 0.70 1</ambient><diffuse>0.75 0.73 0.70 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== OUTER WALLS (30cm high, 5cm thick) ===== -->

    <!-- North wall - full -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 2.8 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 0.05 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 0.05 0.3</size></box></geometry>
          <material><ambient>0.7 0.55 0.3 1</ambient><diffuse>0.7 0.55 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall - LEFT section -->
    <model name="wall_south_left">
      <static>true</static>
      <pose>-2.5 -2.8 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3 0.05 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 0.05 0.3</size></box></geometry>
          <material><ambient>0.7 0.55 0.3 1</ambient><diffuse>0.7 0.55 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall - RIGHT section -->
    <model name="wall_south_right">
      <static>true</static>
      <pose>2.5 -2.8 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3 0.05 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 0.05 0.3</size></box></geometry>
          <material><ambient>0.7 0.55 0.3 1</ambient><diffuse>0.7 0.55 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="red_tape_south">
      <static>true</static>
      <pose>0 -2.8 0.003 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2 0.08 0.003</size></box></geometry>
          <material><ambient>0.95 0.05 0.05 1</ambient><diffuse>0.95 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall - TOP section -->
    <model name="wall_east_top">
      <static>true</static>
      <pose>3.8 1.4 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.05 2.8 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 2.8 0.3</size></box></geometry>
          <material><ambient>0.7 0.55 0.3 1</ambient><diffuse>0.7 0.55 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall - BOTTOM section -->
    <model name="wall_east_bottom">
      <static>true</static>
      <pose>3.8 -1.8 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.05 2.0 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 2.0 0.3</size></box></geometry>
          <material><ambient>0.7 0.55 0.3 1</ambient><diffuse>0.7 0.55 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="red_tape_east">
      <static>true</static>
      <pose>3.8 -0.4 0.003 0 0 1.57</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.8 0.08 0.003</size></box></geometry>
          <material><ambient>0.95 0.05 0.05 1</ambient><diffuse>0.95 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall - full -->
    <model name="wall_west">
      <static>true</static>
      <pose>-3.8 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.05 5.6 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 5.6 0.3</size></box></geometry>
          <material><ambient>0.7 0.55 0.3 1</ambient><diffuse>0.7 0.55 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== INNER WALLS - CENTRAL ISLAND LOOP =====
         Island wall at y=0 with a loop around it, plus two chicane stubs.
         All gaps are >= 1.26 m (robot + inflation). -->

    <model name="iwall_island">
      <static>true</static>
      <pose>0 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.4 0.10 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.4 0.10 0.3</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="iwall_stub_n">
      <static>true</static>
      <pose>-1.0 2.225 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.10 1.25 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.10 1.25 0.3</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="iwall_stub_s">
      <static>true</static>
      <pose>1.1 -2.225 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.10 1.25 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.10 1.25 0.3</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== WORKSTATION TABLES (same as mapping world - permanent fixtures) ===== -->

    <!-- WS01 - against NORTH wall, left zone -->
    <model name="table_ws01">
      <static>true</static>
      <pose>-2.0 2.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.5 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.5 0.1</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- WS02 - against WEST wall, center zone -->
    <model name="table_ws02">
      <static>true</static>
      <pose>-3.3 0.0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.8 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.8 0.1</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- WS03 - against NORTH wall, right zone -->
    <model name="table_ws03">
      <static>true</static>
      <pose>2.0 2.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.5 0.1</size></box></geometry></collision>
