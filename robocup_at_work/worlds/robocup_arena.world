      <visual name="top"><pose>0 0.08 0 0 0 0</pose><geometry><box><size>0.11 0.03 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="mid"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.11 0.03 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="bot"><pose>0 -0.08 0 0 0 0</pose><geometry><box><size>0.11 0.03 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
    </link></model>
    <model name="end_N"><static>true</static><pose>-2.9 2.2 0.004 0 0 0</pose><link name="l">
      <visual name="left"><pose>-0.04 0 0 0 0 0</pose><geometry><box><size>0.03 0.19 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="right"><pose>0.04 0 0 0 0 0</pose><geometry><box><size>0.03 0.19 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="diag"><pose>0 0 0 0 0 0.5</pose><geometry><box><size>0.03 0.2 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
    </link></model>
    <model name="end_D"><static>true</static><pose>-2.7 2.2 0.004 0 0 0</pose><link name="l">
      <visual name="stem"><pose>-0.04 0 0 0 0 0</pose><geometry><box><size>0.03 0.19 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="top"><pose>0 0.08 0 0 0 0</pose><geometry><box><size>0.08 0.03 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="bot"><pose>0 -0.08 0 0 0 0</pose><geometry><box><size>0.08 0.03 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="right"><pose>0.04 0 0 0 0 0</pose><geometry><box><size>0.03 0.16 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
    </link></model>

    <!-- ================================================================ -->
    <!-- Dynamic obstacles - lidar only, not in the static map.           -->
    <!-- Nav2 obstacle_layer picks these up from /scan during navigation. -->
    <!-- Reposition freely between runs to simulate real variability.     -->
    <!-- ================================================================ -->

    <!-- Obstacles 1+2 block the north chicane, so the robot has to reroute
         to reach WS01. -->
    <model name="obs_1">
      <static>true</static>
      <pose>-1.0 0.55 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obs_2">
      <static>true</static>
      <pose>-1.0 1.15 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: south corridor, forces an avoidance curve -->
    <model name="obs_3">
      <static>true</static>
      <pose>-0.2 -1.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.3 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.3 0.4</size></box></geometry>
          <material><ambient>0.5 0.3 0.1 1</ambient><diffuse>0.5 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 4: narrows the east loop to 1.3 m -->
    <model name="obs_4">
      <static>true</static>
      <pose>2.3 -0.3 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.5 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.5 0.3</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

