<?xml version="1.0"?>
<model>
  <name>robocup_tags</name>
  <version>1.0</version>
  <description>
    Material scripts and tag36h11 textures for the RoboCup@Work workstation
    AprilTags. Holds no geometry of its own - the world file references the
    materials via model://robocup_tags/materials/... URIs.
  </description>
</model>
